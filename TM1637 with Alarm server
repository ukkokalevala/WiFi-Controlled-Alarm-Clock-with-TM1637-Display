#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <WiFiUdp.h>
#include <NTPClient.h>
#include <TM1637Display.h>
#include <TimeLib.h>

// ---------- CONFIG ----------
const char* WIFI_SSID     = "YOUR_SSID";
const char* WIFI_PASSWORD = "YOUR_PASSWORD";

// Set your timezone offset in seconds
// Examples: UTC+0 = 0, UTC+1 = 3600, UTC+2 = 7200, UTC-5 = -18000
// South Africa (SAST) = UTC+2 = 7200
const long  UTC_OFFSET_SECONDS = 7200;
const char* NTP_SERVER         = "pool.ntp.org";

// ---------- PINS ----------
#define TM_CLK_PIN   D2   // GPIO4
#define TM_DIO_PIN   D1   // GPIO5
#define BUZZER_PIN   D5   // GPIO14
#define BUTTON_PIN   D6   // GPIO12

// ---------- OBJECTS ----------
TM1637Display display(TM_CLK_PIN, TM_DIO_PIN);
ESP8266WebServer server(80);
WiFiUDP ntpUDP;
NTPClient timeClient(ntpUDP, NTP_SERVER, UTC_OFFSET_SECONDS, 60000); // update every 60s

// ---------- STATE ----------
bool     alarmEnabled = false;
int      alarmHour    = 7;
int      alarmMinute  = 0;
bool     alarmRinging = false;
bool     snoozeActive = false;
int      snoozeMinutes = 5;
unsigned long snoozeUntil = 0;

unsigned long lastDisplayUpdate = 0;
unsigned long lastButtonPress   = 0;
bool          lastButtonState   = HIGH;

// ---------- SETUP ----------
void setup() {
  Serial.begin(9600);
  delay(200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  display.setBrightness(5);
  display.clear();

  // Show "boot" style placeholder
  display.showNumberDec(0, false);

  // Connect WiFi
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("Connected! IP: ");
  Serial.println(WiFi.localIP());

  // NTP
  timeClient.begin();

  // Web routes
  server.on("/",       handleRoot);
  server.on("/set",    handleSetAlarm);
  server.on("/stop",   handleStopAlarm);
  server.on("/snooze", handleSnooze);
  server.on("/status", handleStatus);
  server.begin();
  Serial.println("Web server started");
}

// ---------- LOOP ----------
void loop() {
  server.handleClient();
  timeClient.update();

  handleButton();

  // Check if it's time to ring
  checkAlarm();

  // Update display every 500ms
  if (millis() - lastDisplayUpdate > 500) {
    lastDisplayUpdate = millis();
    updateDisplay();
  }

  // Buzzer pattern while ringing
  if (alarmRinging) {
    tone(BUZZER_PIN, 2000, 200);
  }
}

// ---------- DISPLAY ----------
void updateDisplay() {
  if (alarmRinging) {
    // Flash "AL" style — we just blink the current time
    static bool blink = false;
    blink = !blink;
    if (blink) {
      int h = timeClient.getHours();
      int m = timeClient.getMinutes();
      display.showNumberDecEx(h * 100 + m, 0b01000000, true);
    } else {
      display.clear();
    }
    return;
  }

  int h = timeClient.getHours();
  int m = timeClient.getMinutes();
  // 0b01000000 lights the middle colon
  display.showNumberDecEx(h * 100 + m, 0b01000000, true);
}

// ---------- ALARM LOGIC ----------
void checkAlarm() {
  if (!alarmEnabled) return;
  if (alarmRinging) return;

  // Snooze check
  if (snoozeActive) {
    if (millis() >= snoozeUntil) {
      snoozeActive = false;
      alarmRinging = true;
    }
    return;
  }

  int h = timeClient.getHours();
  int m = timeClient.getMinutes();
  int s = timeClient.getSeconds();

  if (h == alarmHour && m == alarmMinute && s < 2) {
    alarmRinging = true;
    Serial.println("ALARM!");
  }
}

void stopAlarm() {
  alarmRinging = false;
  snoozeActive = false;
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  Serial.println("Alarm stopped");
}

void snoozeAlarm() {
  alarmRinging = false;
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  snoozeActive = true;
  snoozeUntil = millis() + (unsigned long)snoozeMinutes * 60000UL;
  Serial.print("Snoozed for ");
  Serial.print(snoozeMinutes);
  Serial.println(" minutes");
}

// ---------- BUTTON ----------
void handleButton() {
  bool state = digitalRead(BUTTON_PIN);
  if (state == LOW && lastButtonState == HIGH && (millis() - lastButtonPress > 300)) {
    lastButtonPress = millis();
    if (alarmRinging) {
      stopAlarm();
    } else if (snoozeActive) {
      stopAlarm();
    }
  }
  lastButtonState = state;
}

// ---------- WEB HANDLERS ----------
void handleRoot() {
  String html = R"HTML(
<!DOCTYPE html><html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>WiFi Alarm Clock</title>
<style>
