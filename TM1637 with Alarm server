  server.send(200, "text/html", html);
}

void handleSetAlarm() {
  if (server.hasArg("time")) {
    String t = server.arg("time");  // "HH:MM"
    int colon = t.indexOf(':');
    if (colon > 0) {
      alarmHour   = t.substring(0, colon).toInt();
      alarmMinute = t.substring(colon + 1).toInt();
      alarmEnabled = true;
      stopAlarm();
      Serial.printf("Alarm set to %02d:%02d\n", alarmHour, alarmMinute);
    }
  }
  if (server.hasArg("snooze")) {
    int s = server.arg("snooze").toInt();
    if (s >= 1 && s <= 30) snoozeMinutes = s;
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleStopAlarm() {
  stopAlarm();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleSnooze() {
  if (alarmRinging) snoozeAlarm();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleStatus() {
  char buf[160];
  snprintf(buf, sizeof(buf),
    "{\"enabled\":%s,\"time\":\"%02d:%02d\",\"ringing\":%s,\"snoozed\":%s}",
    alarmEnabled ? "true" : "false",
    alarmHour, alarmMinute,
    alarmRinging ? "true" : "false",
    snoozeActive ? "true" : "false");
  server.send(200, "application/json", buf);
}
