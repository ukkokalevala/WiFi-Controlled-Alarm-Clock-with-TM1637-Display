void handleSetAlarm() {
  if (server.hasArg("time")) {
    String t = server.arg("time");
    int colon = t.indexOf(':');
    if (colon > 0) {
      alarmHour   = t.substring(0, colon).toInt();
      alarmMinute = t.substring(colon + 1).toInt();
      alarmEnabled = true;
      stopAlarm();
    }
  }
  if (server.hasArg("snooze")) {
    int s = server.arg("snooze").toInt();
    if (s >= 1 && s <= 30) snoozeMinutes = s;
  }
  if (server.hasArg("melody")) {
    int m = server.arg("melody").toInt();
    if (m >= 0 && m < MELODY_COUNT) selectedMelody = m;
  }
  minuteBeepEnabled = server.hasArg("minutebeep");

  server.sendHeader("Location", "/");
  server.send(303);
}

void handleStopAlarm() {
  stopAlarm();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleSnooze() {
  if (alarmRinging) snoozeAlarm();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleSetMelody() {
  if (server.hasArg("id")) {
    int m = server.arg("id").toInt();
    if (m >= 0 && m < MELODY_COUNT) selectedMelody = m;
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

// Play the selected melody once (not as an alarm) for preview
void handleTestMelody() {
  const Note* melody = MELODIES[selectedMelody];
  int len = MELODY_LENGTHS[selectedMelody];
  for (int i = 0; i < len; i++) {
    if (melody[i].freq > 0) tone(BUZZER_PIN, melody[i].freq, melody[i].dur);
    delay(melody[i].dur);
    noTone(BUZZER_PIN);
    delay(20);
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleStatus() {
  char buf[220];
  snprintf(buf, sizeof(buf),
    "{\"enabled\":%s,\"time\":\"%02d:%02d\",\"ringing\":%s,\"snoozed\":%s,\"melody\":%d,\"minutebeep\":%s}",
    alarmEnabled ? "true" : "false",
    alarmHour, alarmMinute,
    alarmRinging ? "true" : "false",
    snoozeActive ? "true" : "false",
    selectedMelody,
    minuteBeepEnabled ? "true" : "false");
  server.send(200, "application/json", buf);
}
