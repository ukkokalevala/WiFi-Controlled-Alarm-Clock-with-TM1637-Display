#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <WiFiUdp.h>
#include <NTPClient.h>
#include <TM1637Display.h>
#include <TimeLib.h>

// ---------- CONFIG ----------
const char* WIFI_SSID     = "YOUR_SSID";
const char* WIFI_PASSWORD = "YOUR_PASSWORD";

// Timezone offset in seconds. UTC+2 (South Africa) = 7200
const long  UTC_OFFSET_SECONDS = 7200;
const char* NTP_SERVER         = "pool.ntp.org";

// ---------- PINS ----------
#define TM_CLK_PIN   D2
#define TM_DIO_PIN   D1
#define BUZZER_PIN   D5
#define BUTTON_PIN   D6

// ---------- OBJECTS ----------
TM1637Display display(TM_CLK_PIN, TM_DIO_PIN);
ESP8266WebServer server(80);
WiFiUDP ntpUDP;
NTPClient timeClient(ntpUDP, NTP_SERVER, UTC_OFFSET_SECONDS, 60000);

// ---------- STATE ----------
bool     alarmEnabled  = false;
int      alarmHour     = 7;
int      alarmMinute   = 0;
bool     alarmRinging  = false;
bool     snoozeActive  = false;
int      snoozeMinutes = 5;
unsigned long snoozeUntil = 0;

unsigned long lastDisplayUpdate = 0;
unsigned long lastButtonPress   = 0;
bool          lastButtonState   = HIGH;
int           lastMinuteTick    = -1;

// Melody selection (0..2)
int selectedMelody = 0;
bool minuteBeepEnabled = false;

// ---------- MELODIES ----------
struct Note { uint16_t freq; uint16_t dur; };

// 0: Gentle Morning Chime (rising major arpeggio)
const Note MELODY_CHIME[] = {
  { 523, 200 }, { 659, 200 }, { 784, 200 }, { 1047, 400 },
  { 784, 200 }, { 659, 200 }, { 523, 400 }, { 0, 700 }
};

// 1: Soft Bell (two-note pattern, calm)
const Note MELODY_BELL[] = {
  { 880, 300 }, { 660, 300 }, { 0, 200 },
  { 880, 300 }, { 660, 300 }, { 0, 800 }
};

// 2: Upbeat Rise (four notes, gentle wakeup)
const Note MELODY_RISE[] = {
  { 392, 150 }, { 523, 150 }, { 659, 150 }, { 784, 250 }, { 0, 150 },
  { 659, 150 }, { 784, 150 }, { 1047, 400 }, { 0, 800 }
};

const Note* MELODIES[]     = { MELODY_CHIME, MELODY_BELL, MELODY_RISE };
const int   MELODY_LENGTHS[] = {
  sizeof(MELODY_CHIME) / sizeof(Note),
  sizeof(MELODY_BELL)  / sizeof(Note),
  sizeof(MELODY_RISE)  / sizeof(Note)
};
const char* MELODY_NAMES[] = { "Morning Chime", "Soft Bell", "Upbeat Rise" };
const int   MELODY_COUNT   = 3;

// Melody player state
int           melodyIndex     = 0;
unsigned long melodyNoteStart = 0;
bool          melodyActive    = false;

// ---------- SETUP ----------
void setup() {
  Serial.begin(9600);
  delay(200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  display.setBrightness(5);
  display.clear();
  display.showNumberDec(0, false);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("Connected! IP: ");
  Serial.println(WiFi.localIP());

  timeClient.begin();

  server.on("/",       handleRoot);
  server.on("/set",    handleSetAlarm);
  server.on("/stop",   handleStopAlarm);
  server.on("/snooze", handleSnooze);
  server.on("/status", handleStatus);
  server.on("/melody", handleSetMelody);
  server.on("/test",   handleTestMelody);
  server.begin();
  Serial.println("Web server started");
}

// ---------- LOOP ----------
void loop() {
  server.handleClient();
  timeClient.update();

  handleButton();
  checkAlarm();
  updateMelody();
  handleMinuteBeep();

  if (millis() - lastDisplayUpdate > 500) {
    lastDisplayUpdate = millis();
    updateDisplay();
  }
}

// ---------- DISPLAY ----------
void updateDisplay() {
  if (alarmRinging) {
    static bool blink = false;
    blink = !blink;
    if (blink) {
      int h = timeClient.getHours();
      int m = timeClient.getMinutes();
      display.showNumberDecEx(h * 100 + m, 0b01000000, true);
    } else {
      display.clear();
    }
    return;
  }
  int h = timeClient.getHours();
  int m = timeClient.getMinutes();
  display.showNumberDecEx(h * 100 + m, 0b01000000, true);
}

// ---------- ALARM LOGIC ----------
void checkAlarm() {
  if (!alarmEnabled || alarmRinging) return;

  if (snoozeActive) {
    if (millis() >= snoozeUntil) {
      snoozeActive = false;
      alarmRinging = true;
    }
    return;
  }

  int h = timeClient.getHours();
  int m = timeClient.getMinutes();
  int s = timeClient.getSeconds();

  if (h == alarmHour && m == alarmMinute && s < 2) {
    alarmRinging = true;
    Serial.println("ALARM!");
  }
}

void stopAlarm() {
  alarmRinging = false;
  snoozeActive = false;
  melodyActive = false;
  melodyIndex  = 0;
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  Serial.println("Alarm stopped");
}

void snoozeAlarm() {
  alarmRinging = false;
  melodyActive = false;
  melodyIndex  = 0;
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  snoozeActive = true;
  snoozeUntil  = millis() + (unsigned long)snoozeMinutes * 60000UL;
  Serial.printf("Snoozed for %d minutes\n", snoozeMinutes);
}

// ---------- MELODY PLAYER ----------
void updateMelody() {
  if (!alarmRinging) {
    if (melodyActive) {
      noTone(BUZZER_PIN);
      melodyActive = false;
      melodyIndex  = 0;
    }
    return;
  }

  unsigned long now = millis();
  const Note* melody = MELODIES[selectedMelody];
  int len = MELODY_LENGTHS[selectedMelody];

  if (!melodyActive) {
    melodyActive    = true;
    melodyIndex     = 0;
    melodyNoteStart = now;
    Note n = melody[melodyIndex];
    if (n.freq > 0) tone(BUZZER_PIN, n.freq, n.dur);
    return;
  }

  Note current = melody[melodyIndex];
  if (now - melodyNoteStart >= current.dur) {
    noTone(BUZZER_PIN);
    melodyIndex = (melodyIndex + 1) % len;
    melodyNoteStart = now;
    Note next = melody[melodyIndex];
    if (next.freq > 0) tone(BUZZER_PIN, next.freq, next.dur);
  }
}

// ---------- MINUTE BEEP ----------
void handleMinuteBeep() {
  if (!minuteBeepEnabled || alarmRinging || snoozeActive) return;
  int s = timeClient.getSeconds();
  int m = timeClient.getMinutes();
  if (s == 0 && m != lastMinuteTick) {
    lastMinuteTick = m;
    // Soft 800Hz pip for 60ms
    tone(BUZZER_PIN, 800, 60);
  }
}

// ---------- BUTTON ----------
void handleButton() {
  bool state = digitalRead(BUTTON_PIN);
  if (state == LOW && lastButtonState == HIGH && (millis() - lastButtonPress > 300)) {
    lastButtonPress = millis();
    if (alarmRinging || snoozeActive) {
      stopAlarm();
    }
  }
  lastButtonState = state;
}

